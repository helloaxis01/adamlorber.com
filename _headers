# Serve resume PDF inline so browsers can preview it (download is opt-in via link).
/resume.pdf
  Content-Type: application/pdf
  Content-Disposition: inline; filename="Resume_AdamLorber.pdf"
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600, must-revalidate

# HTML must not stick in Safari after the Squarespace → Netlify cutover.
